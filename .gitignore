# dependencies and build output
node_modules/
dist/
web/dist/

# corpus: re-created by `npm run corpus` + `npm run tokenizer` (see data/SOURCES.md)
data/*
!data/SOURCES.md

# checkpoints: only the release model and the tokenizer are committed
models/*
!models/release/
!models/tokenizer.json
models/release/last.bin
models/release/*.tmp

# logs, secrets, editor/OS noise
*.log
logs/
.env
.env.*
*.pem
.vscode/
.idea/
.DS_Store
Thumbs.db
test-results/
playwright-report/
