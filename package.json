{
  "name": "java-autocomplete-lab",
  "version": "0.0.1",
  "private": true,
  "description": "A tiny Java code-completion transformer trained from scratch on a laptop CPU in pure TypeScript, with a 3Blue1Brown-style web lab.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "train": "tsx scripts/train.ts",
    "bench": "tsx scripts/bench.ts",
    "corpus": "tsx scripts/fetch-corpus.ts",
    "tokenizer": "tsx scripts/train-tokenizer.ts",
    "start": "tsx src/server/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json --noEmit",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "ws": "^8.23.0"
  }
}
